{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akanip-options-scanner",
  "main": "cloudflare_worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
          "*/15 3-9 * * MON-FRI"
        ]
  }
}