{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akanip-options-scanner",
  "main": "cloudflare_worker.js",
  "compatibility_date": "2026-10-05",
  "build": {
    "command": "node scripts/prepare-cloudflare-assets.js"
  },
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/15 18-19 * * MON-FRI"
    ]
  }
}